{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:portrait-drawing",
  "visibility": "public",
  "url": "https://github.com/viam-labs/portrait-drawing",
  "description": "Draws polylines on paper with a robotic arm.",
  "models": [
    {
      "api": "rdk:service:generic",
      "model": "viam:portrait-drawing:drawer",
      "short_description": "Draws polylines on paper via a robotic arm.",
      "markdown_link": "README.md"
    },
    {
      "api": "rdk:service:generic",
      "model": "viam:portrait-drawing:stroke-generator",
      "short_description": "Turns an image into ordered 2D polylines for the drawer.",
      "markdown_link": "README.md"
    }
  ],
  "applications": null,
  "markdown_link": "README.md",
  "entrypoint": "bin/portrait-drawing",
  "first_run": "first_run.sh",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "darwin/arm64"
    ]
  }
}
